# Database binary
*.db
maintenance.db

# Python compiled bytecode
__pycache__/
*.pyc

# Environment files
.env
.venv/
# C-MAPSS: only FD001 is committed (the demo subset); the others come from scripts/fetch_cmapss.py
data/cmapss/*FD002*
data/cmapss/*FD003*
data/cmapss/*FD004*

# trained models: only the FD001 demo model is committed; the rest is rebuilt with `python -m pdm.train`
models/*.joblib
!models/turbofan_FD001.joblib

# lock file used while the dashboard builds the database
*.db.lock

# SQLite write-ahead log files
*.db-wal
*.db-shm
